{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "darkBg0": "#1a1b26",
    "darkBg1": "#1e2030",
    "darkBg2": "#292e42",
    "darkBorder": "#3b4261",
    "darkBorderActive": "#545c7e",
    "darkText": "#c8d3f5",
    "darkMuted": "#737aa2",
    "darkBlue": "#82aaff",
    "darkCyan": "#86e1fc",
    "darkPurple": "#c099ff",
    "darkAmber": "#ffc777",
    "darkGreen": "#c3e88d",
    "darkRed": "#ff757f",
    "darkOrange": "#ff966c",
    "lightBg0": "#e1e2e7",
    "lightBg1": "#d5d6db",
    "lightBg2": "#c8c9ce",
    "lightBorder": "#a8aecb",
    "lightBorderActive": "#9699a8",
    "lightText": "#3760bf",
    "lightMuted": "#8990a3",
    "lightBlue": "#2e7de9",
    "lightPurple": "#9854f1",
    "lightAmber": "#8c6c3e",
    "lightGreen": "#587539",
    "lightRed": "#f52a65",
    "lightOrange": "#b15c00"
  },
  "theme": {
    "primary": { "dark": "darkBlue", "light": "lightBlue" },
    "secondary": { "dark": "darkPurple", "light": "lightPurple" },
    "accent": { "dark": "darkOrange", "light": "lightOrange" },
    "error": { "dark": "darkRed", "light": "lightRed" },
    "warning": { "dark": "darkAmber", "light": "lightAmber" },
    "success": { "dark": "darkGreen", "light": "lightGreen" },
    "info": { "dark": "darkCyan", "light": "lightBlue" },
    "text": { "dark": "darkText", "light": "lightText" },
    "textMuted": { "dark": "darkMuted", "light": "lightMuted" },
    "selectedListItemText": { "dark": "darkBg0", "light": "lightBg0" },
    "background": { "dark": "darkBg0", "light": "lightBg0" },
    "backgroundPanel": { "dark": "darkBg1", "light": "lightBg1" },
    "backgroundElement": { "dark": "darkBg2", "light": "lightBg2" },
    "border": { "dark": "darkBorder", "light": "lightBorder" },
    "borderActive": { "dark": "darkBorderActive", "light": "lightBorderActive" },
    "diffAdded": { "dark": "#4fd6be", "light": "#1e725c" },
    "diffRemoved": { "dark": "#c53b53", "light": "#c53b53" },
    "syntaxKeyword": { "dark": "darkPurple", "light": "lightPurple" },
    "syntaxString": { "dark": "darkGreen", "light": "lightGreen" },
    "syntaxFunction": { "dark": "darkBlue", "light": "lightBlue" },
    "syntaxComment": { "dark": "darkMuted", "light": "lightMuted" },
    "markdownHeading": { "dark": "darkBlue", "light": "lightBlue" },
    "markdownLink": { "dark": "darkCyan", "light": "lightBlue" },
    "working": { "dark": "darkCyan", "light": "lightBlue" },
    "blocked": { "dark": "darkAmber", "light": "lightAmber" },
    "done": { "dark": "darkGreen", "light": "lightGreen" },
    "idle": { "dark": "darkMuted", "light": "lightMuted" },
    "question": { "dark": "darkOrange", "light": "lightOrange" }
  }
}
