{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "darkBg0": "#1e1e2e",
    "darkBg1": "#181825",
    "darkBg2": "#313244",
    "darkBorder": "#45475a",
    "darkBorderActive": "#6c7086",
    "darkText": "#cdd6f4",
    "darkMuted": "#7f849c",
    "darkBlue": "#89b4fa",
    "darkMauve": "#cba6f7",
    "darkPeach": "#fab387",
    "darkYellow": "#f9e2af",
    "darkGreen": "#a6e3a1",
    "darkRed": "#f38ba8",
    "darkTeal": "#94e2d5",
    "lightBg0": "#eff1f5",
    "lightBg1": "#e6e9ef",
    "lightBg2": "#ccd0da",
    "lightBorder": "#bcc0cc",
    "lightBorderActive": "#9ca0b0",
    "lightText": "#4c4f69",
    "lightMuted": "#8c8fa1",
    "lightBlue": "#1e66f5",
    "lightMauve": "#8839ef",
    "lightPeach": "#fe640b",
    "lightYellow": "#df8e1d",
    "lightGreen": "#40a02b",
    "lightRed": "#d20f39",
    "lightTeal": "#179299"
  },
  "theme": {
    "primary": { "dark": "darkBlue", "light": "lightBlue" },
    "secondary": { "dark": "darkMauve", "light": "lightMauve" },
    "accent": { "dark": "darkPeach", "light": "lightPeach" },
    "error": { "dark": "darkRed", "light": "lightRed" },
    "warning": { "dark": "darkYellow", "light": "lightYellow" },
    "success": { "dark": "darkGreen", "light": "lightGreen" },
    "info": { "dark": "darkTeal", "light": "lightTeal" },
    "text": { "dark": "darkText", "light": "lightText" },
    "textMuted": { "dark": "darkMuted", "light": "lightMuted" },
    "selectedListItemText": { "dark": "darkBg0", "light": "lightBg0" },
    "background": { "dark": "darkBg0", "light": "lightBg0" },
    "backgroundPanel": { "dark": "darkBg1", "light": "lightBg1" },
    "backgroundElement": { "dark": "darkBg2", "light": "lightBg2" },
    "border": { "dark": "darkBorder", "light": "lightBorder" },
    "borderActive": { "dark": "darkBorderActive", "light": "lightBorderActive" },
    "diffAdded": { "dark": "darkGreen", "light": "lightGreen" },
    "diffRemoved": { "dark": "darkRed", "light": "lightRed" },
    "syntaxKeyword": { "dark": "darkMauve", "light": "lightMauve" },
    "syntaxString": { "dark": "darkGreen", "light": "lightGreen" },
    "syntaxFunction": { "dark": "darkBlue", "light": "lightBlue" },
    "syntaxComment": { "dark": "darkMuted", "light": "lightMuted" },
    "markdownHeading": { "dark": "darkBlue", "light": "lightBlue" },
    "markdownLink": { "dark": "darkTeal", "light": "lightTeal" },
    "working": { "dark": "darkBlue", "light": "lightBlue" },
    "blocked": { "dark": "darkYellow", "light": "lightYellow" },
    "done": { "dark": "darkGreen", "light": "lightGreen" },
    "idle": { "dark": "darkMuted", "light": "lightMuted" },
    "question": { "dark": "darkPeach", "light": "lightPeach" }
  }
}
