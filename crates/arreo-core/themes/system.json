{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "darkFg": "7",
    "darkMuted": "8",
    "darkAccent": "6",
    "darkWarn": "3",
    "darkOk": "2",
    "darkBad": "1",
    "darkBlue": "4",
    "lightFg": "0",
    "lightMuted": "8",
    "lightAccent": "6",
    "lightWarn": "3",
    "lightOk": "2",
    "lightBad": "1",
    "lightBlue": "4"
  },
  "theme": {
    "primary": { "dark": "darkAccent", "light": "lightBlue" },
    "secondary": { "dark": "4", "light": "5" },
    "accent": { "dark": "darkAccent", "light": "lightAccent" },
    "error": { "dark": "darkBad", "light": "lightBad" },
    "warning": { "dark": "darkWarn", "light": "lightWarn" },
    "success": { "dark": "darkOk", "light": "lightOk" },
    "info": { "dark": "darkAccent", "light": "lightAccent" },
    "text": { "dark": "darkFg", "light": "lightFg" },
    "textMuted": { "dark": "darkMuted", "light": "lightMuted" },
    "background": "none",
    "backgroundPanel": "none",
    "backgroundElement": "none",
    "backgroundMenu": "none",
    "border": { "dark": "darkMuted", "light": "lightMuted" },
    "borderActive": { "dark": "darkAccent", "light": "lightAccent" },
    "borderSubtle": { "dark": "8", "light": "8" },
    "diffAdded": { "dark": "darkOk", "light": "lightOk" },
    "diffRemoved": { "dark": "darkBad", "light": "lightBad" },
    "diffContext": { "dark": "darkMuted", "light": "lightMuted" },
    "syntaxComment": { "dark": "darkMuted", "light": "lightMuted" },
    "syntaxKeyword": { "dark": "5", "light": "5" },
    "syntaxString": { "dark": "darkOk", "light": "lightOk" },
    "syntaxFunction": { "dark": "darkAccent", "light": "lightAccent" },
    "markdownHeading": { "dark": "darkAccent", "light": "lightAccent" },
    "markdownLink": { "dark": "4", "light": "4" },
    "working": { "dark": "darkAccent", "light": "lightAccent" },
    "blocked": { "dark": "darkWarn", "light": "lightWarn" },
    "done": { "dark": "darkOk", "light": "lightOk" },
    "idle": { "dark": "darkMuted", "light": "lightMuted" },
    "question": { "dark": "darkWarn", "light": "lightWarn" }
  }
}
