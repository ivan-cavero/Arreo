{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "darkBg0": "#0e1116",
    "darkBg1": "#151a21",
    "darkBg2": "#1b222c",
    "darkBorder": "#2a303c",
    "darkBorderActive": "#7dcfff",
    "darkText": "#c0caf5",
    "darkMuted": "#6b7280",
    "darkCyan": "#7dcfff",
    "darkPurple": "#bb9af7",
    "darkAmber": "#e0af68",
    "darkGreen": "#9ece6a",
    "darkRed": "#f7768e",
    "lightBg0": "#f7f8fa",
    "lightBg1": "#eceef2",
    "lightBg2": "#dfe3e9",
    "lightBorder": "#c3c9d4",
    "lightBorderActive": "#1f6feb",
    "lightText": "#1b222c",
    "lightMuted": "#6b7280",
    "lightCyan": "#1f6feb",
    "lightPurple": "#7b3ff2",
    "lightAmber": "#b57614",
    "lightGreen": "#3f7d20",
    "lightRed": "#c4344a"
  },
  "theme": {
    "primary": { "dark": "darkCyan", "light": "lightCyan" },
    "secondary": { "dark": "darkPurple", "light": "lightPurple" },
    "accent": { "dark": "darkAmber", "light": "lightAmber" },
    "error": { "dark": "darkRed", "light": "lightRed" },
    "warning": { "dark": "darkAmber", "light": "lightAmber" },
    "success": { "dark": "darkGreen", "light": "lightGreen" },
    "info": { "dark": "darkCyan", "light": "lightCyan" },
    "text": { "dark": "darkText", "light": "lightText" },
    "textMuted": { "dark": "darkMuted", "light": "lightMuted" },
    "selectedListItemText": { "dark": "darkBg0", "light": "lightBg0" },
    "background": { "dark": "darkBg0", "light": "lightBg0" },
    "backgroundPanel": { "dark": "darkBg1", "light": "lightBg1" },
    "backgroundElement": { "dark": "darkBg2", "light": "lightBg2" },
    "backgroundMenu": { "dark": "darkBg1", "light": "lightBg1" },
    "border": { "dark": "darkBorder", "light": "lightBorder" },
    "borderActive": { "dark": "darkBorderActive", "light": "lightBorderActive" },
    "borderSubtle": { "dark": "darkBg2", "light": "lightBg2" },
    "diffAdded": { "dark": "darkGreen", "light": "lightGreen" },
    "diffRemoved": { "dark": "darkRed", "light": "lightRed" },
    "diffContext": { "dark": "darkMuted", "light": "lightMuted" },
    "syntaxKeyword": { "dark": "darkPurple", "light": "lightPurple" },
    "syntaxString": { "dark": "darkGreen", "light": "lightGreen" },
    "syntaxFunction": { "dark": "darkCyan", "light": "lightCyan" },
    "syntaxComment": { "dark": "darkMuted", "light": "lightMuted" },
    "markdownHeading": { "dark": "darkCyan", "light": "lightCyan" },
    "markdownLink": { "dark": "darkPurple", "light": "lightPurple" },
    "markdownCode": { "dark": "darkGreen", "light": "lightGreen" },
    "working": { "dark": "darkCyan", "light": "lightCyan" },
    "blocked": { "dark": "darkAmber", "light": "lightAmber" },
    "done": { "dark": "darkGreen", "light": "lightGreen" },
    "idle": { "dark": "darkMuted", "light": "lightMuted" },
    "question": { "dark": "darkAmber", "light": "lightAmber" }
  }
}
