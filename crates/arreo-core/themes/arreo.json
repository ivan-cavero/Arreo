{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "darkBg": "#121110",
    "darkBgElevated": "#1A1816",
    "darkBgInset": "#0C0B0A",
    "darkBorder": "#2A2724",
    "darkBorderActive": "#3E3A35",
    "darkText": "#EDE7DC",
    "darkMuted": "#9A938A",
    "darkPrimary": "#6FD3E8",
    "darkPrimaryStrong": "#A8E4F2",
    "darkSand": "#D9C6A5",
    "darkQuestion": "#E8B45A",
    "darkBlocked": "#FF9E64",
    "darkDone": "#8FD19E",
    "darkError": "#E5636F",
    "darkIdle": "#6E6A64",
    "lightBg": "#FAF8F4",
    "lightPanel": "#F5F1E8",
    "lightInset": "#EFEAE0",
    "lightBorder": "#D9D2C4",
    "lightBorderActive": "#3E3A35",
    "lightText": "#121110",
    "lightMuted": "#5F5A54",
    "lightPrimary": "#386A74",
    "lightPrimaryStrong": "#547279",
    "lightSand": "#6C6352",
    "lightQuestion": "#745A2D",
    "lightBlocked": "#804F32",
    "lightDone": "#48684F",
    "lightError": "#723238",
    "lightIdle": "#373532"
  },
  "theme": {
    "primary": { "dark": "darkPrimary", "light": "lightPrimary" },
    "primaryStrong": { "dark": "darkPrimaryStrong", "light": "lightPrimaryStrong" },
    "secondary": { "dark": "darkSand", "light": "lightSand" },
    "accent": { "dark": "darkSand", "light": "lightSand" },
    "error": { "dark": "darkError", "light": "lightError" },
    "warning": { "dark": "darkQuestion", "light": "lightQuestion" },
    "success": { "dark": "darkDone", "light": "lightDone" },
    "info": { "dark": "darkPrimary", "light": "lightPrimary" },
    "text": { "dark": "darkText", "light": "lightText" },
    "textMuted": { "dark": "darkMuted", "light": "lightMuted" },
    "selectedListItemText": { "dark": "darkBg", "light": "lightBg" },
    "background": { "dark": "darkBg", "light": "lightBg" },
    "backgroundPanel": { "dark": "darkBgElevated", "light": "lightPanel" },
    "backgroundElement": { "dark": "darkBgInset", "light": "lightInset" },
    "backgroundMenu": { "dark": "darkBgElevated", "light": "lightPanel" },
    "border": { "dark": "darkBorder", "light": "lightBorder" },
    "borderActive": { "dark": "darkBorderActive", "light": "lightBorderActive" },
    "borderSubtle": { "dark": "darkBgElevated", "light": "lightPanel" },
    "diffAdded": { "dark": "darkDone", "light": "lightDone" },
    "diffRemoved": { "dark": "darkError", "light": "lightError" },
    "diffContext": { "dark": "darkMuted", "light": "lightMuted" },
    "diffHunkHeader": { "dark": "darkPrimary", "light": "lightPrimary" },
    "diffHighlightAdded": { "dark": "darkDone", "light": "lightDone" },
    "diffHighlightRemoved": { "dark": "darkError", "light": "lightError" },
    "diffAddedBg": { "dark": "darkBgInset", "light": "lightInset" },
    "diffRemovedBg": { "dark": "darkBgInset", "light": "lightInset" },
    "diffContextBg": { "dark": "darkBg", "light": "lightBg" },
    "diffLineNumber": { "dark": "darkMuted", "light": "lightMuted" },
    "diffAddedLineNumberBg": { "dark": "darkBgInset", "light": "lightInset" },
    "diffRemovedLineNumberBg": { "dark": "darkBgInset", "light": "lightInset" },
    "markdownText": { "dark": "darkText", "light": "lightText" },
    "markdownHeading": { "dark": "darkPrimary", "light": "lightPrimary" },
    "markdownLink": { "dark": "darkPrimary", "light": "lightPrimary" },
    "markdownLinkText": { "dark": "darkPrimary", "light": "lightPrimary" },
    "markdownCode": { "dark": "darkSand", "light": "lightSand" },
    "markdownBlockQuote": { "dark": "darkSand", "light": "lightSand" },
    "markdownEmph": { "dark": "darkSand", "light": "lightSand" },
    "markdownStrong": { "dark": "darkText", "light": "lightText" },
    "markdownHorizontalRule": { "dark": "darkBorder", "light": "lightBorder" },
    "markdownListItem": { "dark": "darkPrimary", "light": "lightPrimary" },
    "markdownListEnumeration": { "dark": "darkPrimary", "light": "lightPrimary" },
    "markdownImage": { "dark": "darkPrimary", "light": "lightPrimary" },
    "markdownImageText": { "dark": "darkMuted", "light": "lightMuted" },
    "markdownCodeBlock": { "dark": "darkText", "light": "lightText" },
    "syntaxComment": { "dark": "darkMuted", "light": "lightMuted" },
    "syntaxKeyword": { "dark": "darkPrimary", "light": "lightPrimary" },
    "syntaxFunction": { "dark": "darkPrimaryStrong", "light": "lightPrimaryStrong" },
    "syntaxVariable": { "dark": "darkText", "light": "lightText" },
    "syntaxString": { "dark": "darkDone", "light": "lightDone" },
    "syntaxNumber": { "dark": "darkSand", "light": "lightSand" },
    "syntaxType": { "dark": "darkPrimaryStrong", "light": "lightPrimaryStrong" },
    "syntaxOperator": { "dark": "darkMuted", "light": "lightMuted" },
    "syntaxPunctuation": { "dark": "darkMuted", "light": "lightMuted" },
    "working": { "dark": "darkPrimary", "light": "lightPrimary" },
    "question": { "dark": "darkQuestion", "light": "lightQuestion" },
    "blocked": { "dark": "darkBlocked", "light": "lightBlocked" },
    "done": { "dark": "darkDone", "light": "lightDone" },
    "idle": { "dark": "darkIdle", "light": "lightIdle" }
  }
}
