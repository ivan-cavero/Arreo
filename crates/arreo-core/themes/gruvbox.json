    "darkRed": "#fb4934",
    "darkGreen": "#b8bb26",
    "darkYellow": "#fabd2f",
    "darkBlue": "#83a598",
    "darkAqua": "#8ec07c",
    "darkOrange": "#fe8019",
    "darkPurple": "#d3869b",
    "lightBg0": "#fbf1c7",
    "lightBg1": "#ebdbb2",
    "lightBg2": "#d5c4a1",
    "lightBorder": "#bdae93",
    "lightBorderActive": "#a89984",
    "lightText": "#3c3836",
    "lightMuted": "#7c6f64",
