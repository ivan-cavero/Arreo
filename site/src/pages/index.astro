</div>

<script>
  const STR = {
    en: {
      'hero-badge': 'Alpha · source build today',
      'hero-title': 'Run 30 agents on your server. <em>Herd them from anywhere.</em>',
      'hero-sub': "A small Rust daemon owns your agents' real terminals. Clients attach — a TUI, a CLI, another server — and every one sees the same truth: live state, per-agent RAM, the exact moment an agent needs you.",
      'install-cmd': 'git clone https://github.com/ivan-cavero/Arreo && cd Arreo && cargo build --workspace',
      'copy': 'Copy', 'copy2': 'Copy',
      'cta-title': 'Run 30 agents. <em>Herd them from your phone.</em>',
      'cta-sub': 'Linux first · Windows/macOS in CI · Apache-2.0 core, AGPL-3.0 relay · signed alpha on the way',
      'install-cmd2': 'git clone https://github.com/ivan-cavero/Arreo && cargo build --workspace',
    },
    es: {
      'hero-badge': 'Alpha · hoy se compila desde fuente',
      'hero-title': 'Corre 30 agentes en tu servidor. <em>Gobiérnalos desde donde sea.</em>',
      'hero-sub': 'Un pequeño daemon en Rust posee las terminales reales de tus agentes. Los clientes se conectan — un TUI, un CLI, otro servidor — y todos ven la misma verdad: estado en vivo, RAM por agente, el momento exacto en que un agente te necesita.',
      'install-cmd': 'git clone https://github.com/ivan-cavero/Arreo && cd Arreo && cargo build --workspace',
      'copy': 'Copiar', 'copy2': 'Copiar',
      'cta-title': 'Corre 30 agentes. <em>Gobiérnalos desde el móvil.</em>',
      'cta-sub': 'Linux primero · Windows/macOS en CI · núcleo Apache-2.0, relay AGPL-3.0 · alpha firmada en camino',
      'install-cmd2': 'git clone https://github.com/ivan-cavero/Arreo && cargo build --workspace',
    },
  };
  function setLang(lang) {
    document.documentElement.lang = lang === 'es' ? 'es' : 'en';
    document.querySelectorAll('[data-i18n]').forEach((el) => {
      const v = STR[lang][el.getAttribute('data-i18n')];
      if (v) el.innerHTML = v;
    });
    document.getElementById('lang-en').classList.toggle('sel', lang === 'en');
    document.getElementById('lang-es').classList.toggle('sel', lang === 'es');
  }
  function showFrame(n, btn) {
    for (let i = 0; i < 3; i++) document.getElementById('frame-' + i).hidden = i !== n;
    document.querySelectorAll('.frametabs button').forEach((b) => b.classList.remove('sel'));
    btn.classList.add('sel');
  }
  function setTheme(name, btn) {
    document.documentElement.removeAttribute('style');
    document.documentElement.setAttribute('data-theme', name);
    document.querySelectorAll('.themepick button').forEach((b) => b.classList.remove('sel'));
    btn.classList.add('sel');
  }
  function copyInstall(btn) {
    const cmd = btn.parentElement.querySelector('.cmd').innerText.replace(/^\$\s*/, '');
    navigator.clipboard.writeText(cmd).then(() => {
      const old = btn.innerText; btn.innerText = '✓';
      setTimeout(() => { btn.innerText = old; }, 1200);
    });
  }
</script>
